# ── Application ───────────────────────────────────────────────────────────────
APP_URL=https://pdf.company.local        # Внешний URL приложения (для OIDC redirect)

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=pdftotextdb
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ──────────────────────────────────────────────────────────────────────
# Redis не требует пароля по умолчанию в docker-compose; для продакшна добавьте:
# REDIS_PASSWORD=change_me

# ── MinIO ──────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret

# ── Keycloak ───────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin
KEYCLOAK_REALM=pdf-to-text
KEYCLOAK_CLIENT_ID=pdf-to-text-api
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET   # из Keycloak UI → Clients → Credentials

# ── API security ───────────────────────────────────────────────────────────────
COOKIE_SECRET=change_me_random_64_char_string_here_xxxxxxxxxxxxxxxxxxxxxxxxx

# ── Translation providers (опционально) ───────────────────────────────────────
OPENAI_API_KEY=
DEEPL_API_KEY=
DEEPSEEK_API_KEY=

# ── nginx ports ────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
